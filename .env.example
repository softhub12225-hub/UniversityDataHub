# ============================================================================
# Reviewer console configuration -- copy to .env and adjust.
#
#   cp .env.example .env
#
# .env is git-ignored and must never be committed.
#
# THE CONSOLE HOLDS NO DATABASE CREDENTIAL. There is exactly one secret-shaped
# value here, and it is a URL: where the API lives. Every request the browser makes
# goes to this app's own /api/review/* route handler, which forwards it to the API
# server-side. That is what keeps the session cookie HttpOnly end to end and keeps
# Postgres credentials out of the browser bundle entirely.
# ============================================================================

# ---------------------------------------------------------------------------
# The API
# ---------------------------------------------------------------------------
# Server-side only -- deliberately NOT prefixed with NEXT_PUBLIC_, so Next.js will
# not inline it into the client bundle. Read at request time, not at build time, so
# one built image can be pointed at staging or production.
#
#   local, API on the host      : http://localhost:8000
#   local, API in docker-compose: http://api:8000
#   deployed                    : https://<your-api-host>
API_BASE_URL=http://localhost:8000

# How long the console waits for the API before reporting API_UNREACHABLE. A
# reachable-but-slow API and a stopped one must not look the same to a reviewer.
API_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------
# Exposed to the browser, and inlined AT BUILD TIME -- a NEXT_PUBLIC_ value cannot
# be changed by restarting the container. Display only; nothing is authorised by it.
# One of: local | ci | staging | production
NEXT_PUBLIC_APP_ENV=local

# ---------------------------------------------------------------------------
# NOT set here, on purpose
# ---------------------------------------------------------------------------
# SESSION_SECRET, POSTGRES_*, S3_* and ARTIFACT_ROOT all belong to the API. The
# console never signs a preview token, never reads a stored artifact from disk and
# never opens a database connection: it asks the API, and the API decides. If you
# find yourself wanting one of those values here, the request belongs on the API.
