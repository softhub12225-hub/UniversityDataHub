# Web app configuration. Copy to .env.local for local development.
# The repository-root .env.example is the authoritative list. Everything the API
# needs -- POSTGRES_*, SESSION_SECRET, S3_*, ARTIFACT_ROOT -- is configured in the
# DataHubBackend repository, not here: this app never opens a database connection.

# Base URL of the FastAPI backend. Server-side only -- deliberately NOT prefixed
# with NEXT_PUBLIC_, so it is never inlined into the browser bundle.
API_BASE_URL=http://localhost:8000

# Backend request timeout in milliseconds.
API_TIMEOUT_MS=5000

# Displayed in the UI. Safe to expose. One of: local | ci | staging | production
NEXT_PUBLIC_APP_ENV=local
